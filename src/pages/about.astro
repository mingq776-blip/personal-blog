---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const skills = [
  ["写作", "技术笔记 / 方法总结 / 长期记录"],
  ["开发", "Web / 自动化 / 数据可视化"],
  ["设计", "内容结构 / 界面原型 / 视觉实验"],
  ["学习", "知识管理 / 项目驱动 / 持续复盘"],
];
---

<BaseLayout title="关于" description={`关于${site.author}，以及这个网站正在记录什么。`}>
  <section class="container grid gap-14 border-b border-line py-20 md:py-28 lg:grid-cols-[0.75fr_1.25fr]">
    <div class="surface relative grid min-h-80 place-items-center overflow-hidden rounded-[2rem]" data-reveal>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_35%_35%,color-mix(in_srgb,var(--accent)_35%,transparent),transparent_45%),radial-gradient(circle_at_70%_65%,color-mix(in_srgb,var(--accent-2)_25%,transparent),transparent_40%)]"></div>
      <span class="relative font-serif text-[8rem] font-bold leading-none text-ink/90">M</span>
    </div>
    <div>
      <p class="eyebrow" data-reveal>About</p>
      <h1 class="display mt-5 text-[clamp(3rem,7vw,6rem)] text-ink" data-reveal>持续学习，也持续交付。</h1>
      <div class="mt-8 grid max-w-2xl gap-5 text-base leading-8 text-muted" data-reveal>
        <p>你好，我是{site.author}。这里是我的文章与作品空间，也是记录认知变化的地方。</p>
        <p>相比只展示最终结果，我更愿意保留过程：为什么做、遇到过什么问题、最后如何取舍。这样写下来的内容，才可能在未来继续被使用。</p>
        <p>目前关注的领域包括个人知识管理、Web 开发、视觉表达，以及如何借助 AI 提高真实生产力。</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3" data-reveal>
        {site.socials.map((item) => <a class="rounded-full border border-line px-4 py-2 text-sm text-muted hover:border-accent/50 hover:text-accent" href={item.href}>{item.label}</a>)}
      </div>
    </div>
  </section>

  <section class="container py-20">
    <p class="eyebrow" data-reveal>What I care about</p>
    <h2 class="display mt-4 text-4xl text-ink md:text-6xl" data-reveal>正在建立的能力</h2>
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {skills.map(([title, text], index) => (
        <article class="surface rounded-[1.35rem] p-6 md:p-8" data-reveal>
          <span class="text-xs uppercase tracking-[0.2em] text-accent">0{index + 1}</span>
          <h3 class="mt-5 font-serif text-2xl font-bold text-ink">{title}</h3>
          <p class="mt-3 text-sm leading-7 text-muted">{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container pb-20">
    <div class="surface overflow-hidden rounded-[2rem] p-8 md:p-12" data-reveal>
      <p class="eyebrow">Now</p>
      <h2 class="display mt-4 max-w-3xl text-3xl text-ink md:text-5xl">目前正在做：持续写作、整理知识系统，并完成更多真实项目。</h2>
      <p class="mt-6 max-w-2xl text-sm leading-7 text-muted">这一段可以替换成你的近况。保持具体、诚实和可更新。</p>
    </div>
  </section>
</BaseLayout>

