---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatCounter from "../components/StatCounter.astro";
import { site } from "../data/site";
import { awards } from "../data/awards";
const values = [
  ["01", "真实优先", "能核验的数据才写进作品，模拟数据、计划值和调研结果分别标注清楚。"],
  ["02", "证据闭环", "每个项目都保留目标、方法、量化结果和使用边界，不只展示结论。"],
  ["03", "持续迭代", "从问卷、模型到网页，把项目逐步整理成可以公开体验的成果。"],
];
const stats = [
  { value: 629, suffix: "", label: "有效问卷" },
  { value: 7, suffix: "", label: "核心项目" },
  { value: 10, suffix: "+", label: "荣誉与实践" },
];
---
<BaseLayout title="个人介绍" description={`关于${site.author}，以及正在形成的项目与能力证据。`}>
  <header class="profile-hero">
    <div class="container profile-hero__grid">
      <div class="issue-index reveal-up"><span>01</span><small>PROFILE</small></div>
      <div class="reveal-up">
        <p class="eyebrow">ABOUT ME</p>
        <h1>从数据调研，<br />到数字交付。</h1>
      </div>
      <p class="profile-hero__lead reveal-up">我是徐晨洋，宁夏大学 2025 级大数据管理与应用本科生。持续围绕问卷研究、AI 原型、科研仿真和 Web 交付积累可量化成果。</p>
    </div>
  </header>

  <section class="container about-grid">
    <div class="about-monogram reveal-up" data-tilt>
      <span>徐</span>
      <small>DATA · RESEARCH · DELIVERY</small>
    </div>
    <div class="about-copy reveal-up">
      <p class="eyebrow">WHO I AM</p>
      <h2>用项目和证据，建立自己的专业画像。</h2>
      <p>2025—2026 学年综合测评 83.56 分，学年班级排名 8/37，上学期排名 6/38，获得三等综合奖学金并通过大学英语四级。当前重点学习高等数学、概率论与数理统计、管理学、经济学和数据分析相关课程。</p>
      <p>我参与过社区 AI 美育、非遗数字化、AI 财务教练、古建灾害模拟和 CMAU 市场调查等项目，负责或参与调研、数据整理、模型原型、研究设计和成果表达，并在团委社团管理部和 KAB 俱乐部参与组织协调、活动主持与材料整理。相比笼统描述，我更希望用问卷数量、模型指标、仿真规模和交付结果说明能力。</p>
      <div class="profile-tags"><span>问卷与统计</span><span>AI 产品原型</span><span>研究设计</span><span>数据可视化</span><span>Web 交付</span><span>组织协调</span></div>
    </div>
  </section>

  <section class="container stats-section">
    <div class="stats-grid">{stats.map((item) => <StatCounter {...item} />)}</div>
  </section>


  <section class="editorial-section editorial-section--awards">
    <div class="container">
      <div class="section-heading reveal-up"><div><p class="section-heading__eyebrow"><span></span>HONORS & CERTIFICATES</p><h2>荣誉与资格</h2></div><div class="section-heading__side"><p>以下信息按简历材料整理，正式投递时可与证书、公示和获奖文件进一步核验。</p></div></div>
      <div class="award-grid">
        {awards.map((item) => <article class="award-card reveal-up"><time>{item.year}</time><h3>{item.title}</h3><p>{item.detail}</p></article>)}
      </div>
    </div>
  </section>

  <section class="editorial-section editorial-section--values">
    <div class="container">
      <div class="section-heading reveal-up"><div><p class="section-heading__eyebrow"><span></span>MY PRINCIPLES</p><h2>展示原则</h2></div><div class="section-heading__side"><p>真实、清楚、不过度包装，是我整理个人作品时的基本标准。</p></div></div>
      <div class="value-grid">
        {values.map(([number, title, text]) => <article class="value-card reveal-up"><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="container about-now reveal-up">
    <span>NOW / 2026</span>
    <h2>继续补强 SQL、Python 与真实业务场景，把现有项目从“完成材料”推进到“可验证作品”。</h2>
    <div><a href="/experience">看项目经历</a><a href="/works">看作品展示</a></div>
  </section>
</BaseLayout>
