---
interface Item {
  label: string;
  value: number;
  color: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
let offset = 0;
const segments = items.map((item) => {
  const segment = { ...item, offset };
  offset += item.value;
  return segment;
});
---
<div class="donut-wrap reveal-up">
  <svg class="donut" viewBox="0 0 120 120" role="img" aria-label="时间分配环形图">
    <circle class="donut__track" cx="60" cy="60" r="46"></circle>
    {segments.map((item) => (
      <circle
        class="donut__segment"
        cx="60"
        cy="60"
        r="46"
        pathLength="100"
        stroke={item.color}
        stroke-dasharray={`${item.value} ${100 - item.value}`}
        stroke-dashoffset={-item.offset}
      ></circle>
    ))}
  </svg>
  <div class="donut-legend">
    {items.map((item) => <span><i style={`background:${item.color}`}></i>{item.label}<strong>{item.value}%</strong></span>)}
  </div>
</div>
