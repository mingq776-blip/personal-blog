---
import { Image } from "astro:assets";
import { formatDate, readingTime } from "../lib/format";

interface Props {
  post: any;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const data = post.data;
---

<article class:list={["group hover-lift surface overflow-hidden rounded-[1.35rem]", compact && "grid md:grid-cols-[0.82fr_1.18fr]"]} data-reveal>
  <a href={`/posts/${post.id}/`} class="block overflow-hidden">
    <Image
      src={data.cover}
      alt={data.coverAlt}
      widths={[420, 720, 960]}
      sizes={compact ? "(max-width: 768px) 100vw, 40vw" : "(max-width: 768px) 100vw, 33vw"}
      format="webp"
      class:list={["h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.035]", compact ? "min-h-56 md:min-h-full" : "aspect-[16/10]"]}
      loading="lazy"
    />
  </a>
  <div class:list={["flex flex-col p-5 md:p-6", compact && "justify-center"]}>
    <div class="flex flex-wrap items-center gap-3 text-[0.68rem] uppercase tracking-[0.16em] text-muted">
      <span class="text-accent">{data.category}</span>
      <span aria-hidden="true">/</span>
      <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
    </div>
    <h3 class:list={["mt-4 font-serif font-bold leading-snug text-ink", compact ? "text-2xl md:text-3xl" : "text-xl md:text-2xl"]}>
      <a href={`/posts/${post.id}/`} class="transition-colors group-hover:text-accent">{data.title}</a>
    </h3>
    <p class="line-clamp-3 mt-3 text-sm leading-7 text-muted">{data.description}</p>
    <div class="mt-auto flex items-center justify-between gap-3 pt-6 text-xs text-muted">
      <span>{readingTime(post.body ?? "")}</span>
      <span class="transition-transform group-hover:translate-x-1">阅读 →</span>
    </div>
  </div>
</article>

