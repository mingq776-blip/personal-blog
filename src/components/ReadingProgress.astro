<div class="fixed left-0 top-0 z-[60] h-0.5 w-full bg-transparent" aria-hidden="true">
  <span id="reading-progress" class="block h-full w-0 bg-[linear-gradient(90deg,var(--accent),var(--accent-2))]"></span>
</div>
<script>
  const initProgress = () => {
    const bar = document.querySelector("#reading-progress") as HTMLElement | null;
    if (!bar) return;
    const update = () => {
      const article = document.querySelector("[data-reading-article]");
      if (!article) return;
      const start = article.getBoundingClientRect().top + window.scrollY;
      const total = Math.max(1, article.scrollHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, (window.scrollY - start) / total));
      bar.style.width = `${progress * 100}%`;
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  };
  initProgress();
  document.addEventListener("astro:page-load", initProgress);
</script>


