---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import MagazineHero from "../components/MagazineHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import StatCounter from "../components/StatCounter.astro";
import ExperienceStack from "../components/ExperienceStack.astro";
import AwardsShowcase from "../components/AwardsShowcase.astro";
import DataBars from "../components/DataBars.astro";
import { site } from "../data/site";
import { experiences, timelineStats } from "../data/experience";
import { awards } from "../data/awards";
import { monthlyProgress, overviewStats } from "../data/metrics";

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

<BaseLayout>
  <MagazineHero />

  <section class="editorial-section editorial-section--profile">
    <div class="container profile-grid">
      <div class="issue-index reveal-up">
        <span>01</span>
        <small>PROFILE</small>
      </div>
      <div class="profile-copy reveal-up">
        <p class="eyebrow">ABOUT THE CREATOR</p>
        <h2>把调研、数据与数字交付，<br />连成一条可验证的成果链。</h2>
        <p>我是徐晨洋，宁夏大学 2025 级大数据管理与应用本科生。每个项目都保留目标、方法、量化证据和使用边界，让能力可以被核验。</p>
      </div>
      <div class="profile-card reveal-up">
        <div class="profile-card__monogram">徐</div>
        <dl>
          <div><dt>身份</dt><dd>{site.role}</dd></div>
          <div><dt>专业</dt><dd>大数据管理与应用</dd></div>
          <div><dt>关注</dt><dd>调研 / AI / 数据 / Web</dd></div>
          <div><dt>状态</dt><dd><i></i> 持续创作中</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="editorial-section editorial-section--experience">
    <div class="container">
      <SectionHeading eyebrow="02 / EXPERIENCE" title="项目经历" description="点击卡片或“下一项”，逐层查看每段实践经历、职责和量化结果。" href="/experience" linkLabel="完整经历" />
    </div>
    <ExperienceStack items={experiences} />
    <div class="container stat-row">
      {timelineStats.slice(0, 2).map((item) => <StatCounter {...item} />)}
      <AwardsShowcase awards={awards} />
    </div>
  </section>

  <section class="editorial-section editorial-section--works">
    <div class="container">
      <SectionHeading eyebrow="03 / SELECTED WORKS" title="作品展示" description="从量化成果清单中选取核心项目，展示目标、职责、技术栈与可核验结果。" href="/works" linkLabel="全部作品" />
      <div class="works-grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index} showImage={false} />)}
      </div>
    </div>
  </section>

  <section class="editorial-section editorial-section--data">
    <div class="container">
      <SectionHeading eyebrow="04 / DATA & METRICS" title="数据图表" description="用可读的图表记录项目推进、能力分布和时间投入，而不是堆叠无意义的数字。" href="/dashboard" linkLabel="查看数据页" />
      <div class="dashboard-preview">
        <div class="stats-grid reveal-up">
          {overviewStats.map((item) => <StatCounter {...item} />)}
        </div>
        <div class="chart-panel reveal-up">
          <div class="chart-panel__head"><span>PROJECT EVIDENCE</span><strong>成果证据覆盖</strong></div>
          <DataBars items={monthlyProgress} />
        </div>
      </div>
    </div>
  </section>

  <section class="container closing-cta reveal-up">
    <span>READY FOR THE NEXT CHAPTER</span>
    <h2>下一步，把一个想法做成<br />真正拿得出手的作品。</h2>
    <div><a href="/works">查看作品</a><a href="https://github.com/mingq776-blip" target="_blank" rel="noreferrer">GitHub</a></div>
  </section>
</BaseLayout>
