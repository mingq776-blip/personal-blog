---
import { Image } from "astro:assets";
import heroLandscape from "../assets/landscapes/lake.webp";
import { site } from "../data/site";
---

<section class="magazine-hero">
  <div class="magazine-grid" aria-hidden="true"></div>
  <div class="container hero-layout">
    <div class="hero-copy">
      <div class="hero-kicker reveal-up">
        <span>VOL. 2026 / ISSUE 10</span>
        <span class="hero-kicker__dot"></span>
        <span>PERSONAL ARCHIVE</span>
      </div>
      <h1 class="hero-title">
        <span class="hero-title__line">把想法</span>
        <span class="hero-title__line hero-title__line--accent">做成作品</span>
      </h1>
      <p class="hero-intro">我是{site.author}，一名持续学习的内容创作者与独立开发者。这里记录项目经历、作品展示与数据变化。</p>
      <div class="hero-actions">
        <a href="/works" class="button button--ink">浏览作品 <span>↗</span></a>
        <a href="/about" class="button button--ghost">认识我 <span>→</span></a>
      </div>
      <div class="hero-meta">
        <span><strong>03</strong> 核心作品</span>
        <span><strong>06</strong> 关注领域</span>
        <span><strong>∞</strong> 持续更新</span>
      </div>
    </div>

    <div class="hero-art reveal-up">
      <Image src={heroLandscape} alt="" widths={[720, 1100, 1500]} format="webp" class="hero-art__photo" loading="eager" />
      <canvas id="magazine-canvas" aria-hidden="true"></canvas>
      <div class="hero-art__ring hero-art__ring--one"></div>
      <div class="hero-art__ring hero-art__ring--two"></div>
      <div class="hero-art__core"><span>CREATE</span><strong>2026</strong><small>WORK IN PROGRESS</small></div>
      <div class="hero-sticker hero-sticker--one">DESIGN</div>
      <div class="hero-sticker hero-sticker--two">CODE</div>
      <div class="hero-sticker hero-sticker--three">DATA</div>
    </div>
  </div>

  <div class="hero-marquee" aria-hidden="true">
    <div class="hero-marquee__track">
      <span>CREATE / RECORD / BUILD / ITERATE /</span>
      <span>CREATE / RECORD / BUILD / ITERATE /</span>
      <span>CREATE / RECORD / BUILD / ITERATE /</span>
    </div>
  </div>
</section>

<script is:inline>
  const initMagazineCanvas = () => {
    const canvas = document.querySelector("#magazine-canvas");
    if (!canvas || canvas.dataset.ready === "true") return;
    canvas.dataset.ready = "true";
    const context = canvas.getContext("2d", { alpha: true });
    if (!context) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const mobile = window.matchMedia("(max-width: 720px)").matches;
    const slowDevice = (navigator.hardwareConcurrency || 8) <= 4;
    const count = reducedMotion ? 34 : mobile ? 42 : slowDevice ? 56 : 78;
    const particles = [];
    const palette = ["#2f8f46", "#74a83b", "#4d9b76", "#9ac95c"];
    let width = 0;
    let height = 0;
    let ratio = 1;
    let visible = true;
    let pointerX = 0;
    let pointerY = 0;
    let targetX = 0;
    let targetY = 0;
    let lastTime = 0;
    const random = (min, max) => Math.random() * (max - min) + min;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      ratio = Math.min(window.devicePixelRatio || 1, 1.5);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
    };

    const reset = () => {
      particles.length = 0;
      for (let index = 0; index < count; index += 1) {
        particles.push({ x: random(0, width), y: random(0, height), vx: random(-0.16, 0.16), vy: random(-0.16, 0.16), size: random(0.8, 2.4), color: palette[index % palette.length] });
      }
    };

    const draw = (time) => {
      if (!visible || document.hidden) {
        requestAnimationFrame(draw);
        return;
      }
      const delta = Math.min(32, time - lastTime || 16) / 16.67;
      lastTime = time;
      context.clearRect(0, 0, width, height);
      pointerX += (targetX - pointerX) * 0.05;
      pointerY += (targetY - pointerY) * 0.05;

      particles.forEach((particle, index) => {
        if (!reducedMotion) {
          particle.x += particle.vx * delta;
          particle.y += particle.vy * delta;
          if (particle.x < -20) particle.x = width + 20;
          if (particle.x > width + 20) particle.x = -20;
          if (particle.y < -20) particle.y = height + 20;
          if (particle.y > height + 20) particle.y = -20;
        }

        const dx = particle.x - pointerX;
        const dy = particle.y - pointerY;
        const glow = Math.max(0, 1 - Math.sqrt(dx * dx + dy * dy) / 210);
        context.beginPath();
        context.fillStyle = particle.color;
        context.globalAlpha = 0.36 + glow * 0.48;
        context.arc(particle.x, particle.y, particle.size + glow * 1.2, 0, Math.PI * 2);
        context.fill();

        for (let targetIndex = index + 1; targetIndex < particles.length; targetIndex += 1) {
          const target = particles[targetIndex];
          const lineX = target.x - particle.x;
          const lineY = target.y - particle.y;
          const lineDistance = Math.sqrt(lineX * lineX + lineY * lineY);
          if (lineDistance < 92) {
            context.beginPath();
            context.strokeStyle = particle.color;
            context.globalAlpha = (1 - lineDistance / 92) * 0.12;
            context.lineWidth = 0.7;
            context.moveTo(particle.x, particle.y);
            context.lineTo(target.x, target.y);
            context.stroke();
          }
        }
      });

      context.globalAlpha = 1;
      requestAnimationFrame(draw);
    };

    resize();
    reset();
    targetX = width * 0.58;
    targetY = height * 0.46;
    pointerX = targetX;
    pointerY = targetY;

    const hero = canvas.closest(".hero-art");
    hero?.addEventListener("pointermove", (event) => {
      const rect = hero.getBoundingClientRect();
      targetX = event.clientX - rect.left;
      targetY = event.clientY - rect.top;
    }, { passive: true });

    new ResizeObserver(() => { resize(); reset(); }).observe(canvas);
    new IntersectionObserver((entries) => { visible = entries[0]?.isIntersecting ?? true; }, { threshold: 0.05 }).observe(canvas);
    requestAnimationFrame(draw);
  };

  initMagazineCanvas();
  document.addEventListener("astro:page-load", initMagazineCanvas);
</script>