---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}
const { eyebrow, title, description, href, linkLabel = "查看全部" } = Astro.props;
---
<div class="section-heading reveal-up">
  <div>
    <p class="section-heading__eyebrow"><span></span>{eyebrow}</p>
    <h2>{title}</h2>
  </div>
  <div class="section-heading__side">
    {description && <p>{description}</p>}
    {href && <a href={href}>{linkLabel}<span>↗</span></a>}
  </div>
</div>
