---
import { site } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <p>LET'S MAKE SOMETHING</p>
      <h2>把每一次学习，<br />变成留下来的作品。</h2>
      <a href={`mailto:${site.email}`}>开始交流 ↗</a>
    </div>
    <div class="site-footer__bottom">
      <span>© {year} {site.author}</span>
      <div>{site.socials.map((item) => <a href={item.href}>{item.label}</a>)}</div>
      <span>BUILT WITH ASTRO</span>
    </div>
  </div>
</footer>
