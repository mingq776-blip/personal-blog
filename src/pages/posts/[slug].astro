---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import PostCard from "../../components/PostCard.astro";
import { formatDate, readingTime } from "../../lib/format";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const related = allPosts
  .filter((item) => item.id !== post.id && (item.data.category === post.data.category || item.data.tags.some((tag) => post.data.tags.includes(tag))))
  .slice(0, 2);
const articleUrl = new URL(`/posts/${post.id}/`, Astro.site ?? site.url);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { "@type": "Person", name: site.author },
  mainEntityOfPage: articleUrl.toString(),
};
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover.src} type="article">
  <ReadingProgress />
  <article data-reading-article>
    <header class="container grid gap-10 py-16 md:py-24 lg:grid-cols-[1fr_0.8fr] lg:items-end">
      <div data-reveal>
        <div class="flex flex-wrap items-center gap-3 text-[0.7rem] uppercase tracking-[0.18em] text-muted">
          <a href={`/categories/${post.data.category}/`} class="text-accent">{post.data.category}</a>
          <span>/</span>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span>/</span>
          <span>{readingTime(post.body ?? "")}</span>
        </div>
        <h1 class="display mt-6 max-w-4xl text-[clamp(2.8rem,7vw,5.6rem)] text-balance text-ink">{post.data.title}</h1>
        <p class="mt-7 max-w-2xl text-base leading-8 text-muted md:text-lg">{post.data.description}</p>
      </div>
      <Image src={post.data.cover} alt={post.data.coverAlt} widths={[520, 900, 1200]} format="webp" class="aspect-[16/11] w-full rounded-[1.5rem] border border-line object-cover shadow-2xl" data-reveal />
    </header>

    <div class="container grid gap-12 lg:grid-cols-[220px_minmax(0,760px)] lg:justify-center">
      <aside class="hidden lg:block" aria-label="文章目录">
        {headings.length > 0 && (
          <nav class="sticky top-28 border-l border-line pl-5">
            <p class="mb-4 text-xs uppercase tracking-[0.18em] text-muted">目录</p>
            {headings.filter((heading) => heading.depth <= 3).map((heading) => (
              <a class="mb-3 block text-xs leading-5 text-muted transition-colors hover:text-accent" href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        )}
      </aside>
      <div class="prose min-w-0 pb-20" data-pagefind-body>
        <span class="sr-only">{post.data.title}</span>
        <Content />
      </div>
    </div>

    <footer class="container max-w-4xl pb-16">
      <div class="flex flex-wrap gap-2 border-t border-line pt-7">
        {post.data.tags.map((tag) => <a href={`/tags/${tag}/`} class="rounded-full border border-line px-3 py-1.5 text-xs text-muted hover:border-accent/50 hover:text-accent">#{tag}</a>)}
      </div>
    </footer>
  </article>

  {related.length > 0 && (
    <section class="container border-t border-line py-20">
      <p class="eyebrow">Keep reading</p>
      <h2 class="display mt-3 text-3xl text-ink md:text-5xl">继续阅读</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {related.map((item) => <PostCard post={item} compact />)}
      </div>
    </section>
  )}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

