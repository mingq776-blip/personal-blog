---
import { Image } from "astro:assets";

interface Props {
  project: any;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const data = project.data;
---

<article class="group hover-lift surface relative overflow-hidden rounded-[1.5rem]" data-reveal>
  <a href={`/projects/${project.id}/`} class="block overflow-hidden">
    <Image
      src={data.cover}
      alt={data.coverAlt}
      widths={[480, 760, 1100]}
      sizes="(max-width: 768px) 100vw, 50vw"
      format="webp"
      class="aspect-[16/10] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
      loading="lazy"
    />
  </a>
  <div class="p-6">
    <div class="flex items-center justify-between gap-4 text-xs uppercase tracking-[0.18em] text-muted">
      <span>Project {String(index + 1).padStart(2, "0")}</span>
      <span>{data.year}</span>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <h3 class="font-serif text-2xl font-bold text-ink">
        <a href={`/projects/${project.id}/`} class="transition-colors group-hover:text-accent">{data.title}</a>
      </h3>
      {data.demo && <span class="rounded-full border border-accent-2/40 px-2 py-0.5 text-[0.62rem] text-accent-2">示例项目</span>}
    </div>
    <p class="line-clamp-2 mt-3 text-sm leading-7 text-muted">{data.summary}</p>
    <div class="mt-5 flex flex-wrap gap-2">
      {data.stack.slice(0, 4).map((item: string) => <span class="rounded-full border border-line px-2.5 py-1 text-[0.68rem] text-muted">{item}</span>)}
    </div>
  </div>
</article>

