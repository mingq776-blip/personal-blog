---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import MagazineHero from "../components/MagazineHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import StatCounter from "../components/StatCounter.astro";
import DataBars from "../components/DataBars.astro";
import { site } from "../data/site";
import { experiences, timelineStats } from "../data/experience";
import { monthlyProgress, overviewStats } from "../data/metrics";

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);
---

<BaseLayout>
  <MagazineHero />

  <section class="editorial-section editorial-section--profile">
    <div class="container profile-grid">
      <div class="issue-index reveal-up">
        <span>01</span>
        <small>PROFILE</small>
      </div>
      <div class="profile-copy reveal-up">
        <p class="eyebrow">ABOUT THE CREATOR</p>
        <h2>我不是在堆叠页面，<br />而是在建立自己的作品档案。</h2>
        <p>我把学习、开发和视觉表达放进同一个系统。每个项目都保留过程、取舍和结果，让经验能被看见，也能被继续使用。</p>
      </div>
      <div class="profile-card reveal-up">
        <div class="profile-card__monogram">M</div>
        <dl>
          <div><dt>身份</dt><dd>{site.role}</dd></div>
          <div><dt>关注</dt><dd>Web / 设计 / 数据 / AI</dd></div>
          <div><dt>状态</dt><dd><i></i> 持续创作中</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="editorial-section editorial-section--experience">
    <div class="container">
      <SectionHeading eyebrow="02 / EXPERIENCE" title="项目经历" description="按照时间顺序整理实践阶段，重点保留我做了什么、解决了什么，以及形成了哪些能力。" href="/experience" linkLabel="完整经历" />
      <div class="experience-strip">
        {experiences.map((item, index) => (
          <article class="experience-card reveal-up" data-tilt>
            <div class="experience-card__top"><span>{String(index + 1).padStart(2, "0")}</span><time>{item.period}</time></div>
            <p>{item.organization}</p>
            <h3>{item.role}</h3>
            <div class="experience-card__text">{item.description}</div>
            <ul>{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
            {item.demo && <em>示例经历</em>}
          </article>
        ))}
      </div>
      <div class="stat-row">
        {timelineStats.map((item) => <StatCounter {...item} />)}
      </div>
    </div>
  </section>

  <section class="editorial-section editorial-section--works">
    <div class="container">
      <SectionHeading eyebrow="03 / SELECTED WORKS" title="作品展示" description="用真实项目结构展示目标、方案和结果。当前示例作品会在正式发布前替换。" href="/works" linkLabel="全部作品" />
      <div class="works-grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </div>
  </section>

  <section class="editorial-section editorial-section--data">
    <div class="container">
      <SectionHeading eyebrow="04 / DATA & METRICS" title="数据图表" description="用可读的图表记录项目推进、能力分布和时间投入，而不是堆叠无意义的数字。" href="/dashboard" linkLabel="查看数据页" />
      <div class="dashboard-preview">
        <div class="stats-grid reveal-up">
          {overviewStats.map((item) => <StatCounter {...item} />)}
        </div>
        <div class="chart-panel reveal-up">
          <div class="chart-panel__head"><span>PROJECT MOMENTUM</span><strong>近 6 个月</strong></div>
          <DataBars items={monthlyProgress} />
        </div>
      </div>
    </div>
  </section>

  <section class="container closing-cta reveal-up">
    <span>READY FOR THE NEXT CHAPTER</span>
    <h2>下一步，把一个想法做成<br />真正拿得出手的作品。</h2>
    <div><a href="/works">查看作品</a><a href={`mailto:${site.email}`}>联系我</a></div>
  </section>
</BaseLayout>
