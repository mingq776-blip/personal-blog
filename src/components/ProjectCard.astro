---
import { Image } from "astro:assets";
interface Props {
  project: any;
  index?: number;
}
const { project, index = 0 } = Astro.props;
const data = project.data;
---
<article class="work-card reveal-up" data-tilt>
  <a class="work-card__image" href={`/works/${project.id}/`} aria-label={data.title}>
    <Image src={data.cover} alt={data.coverAlt} widths={[480, 760, 1100]} sizes="(max-width: 768px) 100vw, 50vw" format="webp" class="work-card__cover" loading="lazy" />
    <span class="work-card__number">{String(index + 1).padStart(2, "0")}</span>
    <span class="work-card__arrow">↗</span>
  </a>
  <div class="work-card__body">
    <div class="work-card__meta">
      <span>{data.year}</span>
      <span>{data.role}</span>
      {data.demo && <em>示例作品</em>}
    </div>
    <h3><a href={`/works/${project.id}/`}>{data.title}</a></h3>
    <p>{data.summary}</p>
    {data.metric && <div class="work-card__metric"><strong>{data.metric}</strong><span>{data.evidence}</span></div>}
    <div class="work-card__stack">
      {data.stack.slice(0, 4).map((item: string) => <span>{item}</span>)}
    </div>
  </div>
</article>
