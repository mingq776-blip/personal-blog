---
import { site } from "../data/site";

const path = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? path === "/" : path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-[color-mix(in_srgb,var(--bg)_82%,transparent)] backdrop-blur-xl">
  <div class="container flex min-h-16 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-3" aria-label={`${site.title} 首页`}>
      <span class="grid size-9 place-items-center rounded-full border border-accent/45 bg-accent/10 text-sm font-black text-accent transition-transform group-hover:rotate-12">
        M
      </span>
      <span class="hidden text-sm font-semibold tracking-[0.16em] text-ink sm:block">
        {site.title.toUpperCase()}
      </span>
    </a>

    <nav class="hidden items-center gap-1 rounded-full border border-line bg-panel/65 p-1 md:flex" aria-label="主导航">
      {site.navigation.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "rounded-full px-3.5 py-2 text-xs transition-colors",
            isActive(item.href) ? "bg-ink text-bg" : "text-muted hover:text-ink",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1.5">
      <a class="grid size-9 place-items-center rounded-full border border-line text-muted transition-colors hover:border-accent/50 hover:text-accent" href="/search" aria-label="搜索">
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
      </a>
      <button data-theme-toggle class="grid size-9 place-items-center rounded-full border border-line text-muted transition-colors hover:border-accent/50 hover:text-accent" type="button" aria-label="切换明暗主题">
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"></path>
          <circle cx="12" cy="12" r="3.5"></circle>
        </svg>
      </button>
      <details class="relative md:hidden">
        <summary class="grid size-9 cursor-pointer list-none place-items-center rounded-full border border-line text-muted transition-colors hover:text-ink" aria-label="打开导航">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav class="absolute right-0 mt-3 grid w-44 gap-1 rounded-2xl border border-line bg-panel-solid p-2 shadow-2xl" aria-label="移动端导航">
          {site.navigation.map((item) => (
            <a href={item.href} class:list={["rounded-xl px-3 py-2 text-sm", isActive(item.href) ? "bg-accent text-[#041114]" : "text-muted hover:bg-line hover:text-ink"]}>
              {item.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

