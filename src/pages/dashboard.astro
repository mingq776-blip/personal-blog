---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatCounter from "../components/StatCounter.astro";
import DataBars from "../components/DataBars.astro";
import DonutChart from "../components/DonutChart.astro";
import { monthlyProgress, overviewStats, skillDistribution, timeAllocation } from "../data/metrics";
---
<BaseLayout title="数据图表" description="用可视化图表展示项目推进、能力分布与时间投入。">
  <header class="page-hero page-hero--dashboard">
    <div class="container page-hero__grid">
      <div class="issue-index reveal-up"><span>04</span><small>DATA</small></div>
      <div class="reveal-up">
        <p class="eyebrow">METRICS & VISUALIZATION</p>
        <h1>让数字说话，<br />但不让数字喧宾夺主。</h1>
      </div>
      <p class="page-hero__intro reveal-up">图表记录项目节奏、能力分布和时间投入，重点是发现变化与下一步行动。</p>
    </div>
  </header>

  <section class="container stats-section">
    <div class="stats-grid">{overviewStats.map((item) => <StatCounter {...item} />)}</div>
  </section>

  <section class="container chart-grid">
    <h2 class="sr-only">数据图表与洞察</h2>
    <article class="chart-panel chart-panel--wide reveal-up">
      <div class="chart-panel__head"><span>EVIDENCE COVERAGE</span><strong>成果证据覆盖</strong></div>
      <DataBars items={monthlyProgress} />
    </article>
    <article class="chart-panel reveal-up">
      <div class="chart-panel__head"><span>OUTCOME MIX</span><strong>成果类型分布</strong></div>
      <DonutChart items={timeAllocation} />
    </article>
    <article class="chart-panel chart-panel--wide reveal-up">
      <div class="chart-panel__head"><span>CAPABILITY EVIDENCE</span><strong>能力证据分布</strong></div>
      <DataBars items={skillDistribution} />
    </article>
    <article class="insight-panel reveal-up">
      <span>01 / INSIGHT</span>
      <h3>优势已经形成，但“证据闭环”仍需加强。</h3>
      <p>当前最有说服力的是调研与统计、AI 原型、科研仿真和数字交付四条证据链。下一步应补充真实业务数据和可复现代码。</p>
    </article>
    <article class="insight-panel insight-panel--accent reveal-up">
      <span>02 / NEXT ACTION</span>
      <h3>接入真实测试，补一个 SQL + 可视化分析项目。</h3>
      <p>优先把青穗接入 30—50 名真实学生测试，并为 CMAU 补齐源数据和统计代码。</p>
    </article>
  </section>
</BaseLayout>
