---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const { eyebrow, title, description, href, linkLabel = "查看全部" } = Astro.props;
---

<div class="mb-8 flex flex-col gap-5 md:flex-row md:items-end md:justify-between" data-reveal>
  <div class="max-w-2xl">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="display mt-3 text-3xl text-ink md:text-5xl">{title}</h2>
    {description && <p class="mt-4 max-w-xl text-sm leading-7 text-muted md:text-base">{description}</p>}
  </div>
  {href && (
    <a href={href} class="group inline-flex w-fit items-center gap-2 text-sm text-accent">
      {linkLabel}
      <span class="transition-transform group-hover:translate-x-1">→</span>
    </a>
  )}
</div>

